[physics]

3d/physics_engine="Jolt Physics"
jolt_physics_3d/simulation/penetration_slop=0.0005
jolt_physics_3d/simulation/speculative_contact_distance=0.005
jolt_physics_3d/limits/temporary_memory_buffer_size=64
jolt_physics_3d/limits/max_bodies=131072
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=65536
common/physics_interpolation=true

[rendering]

